# Supabase Connection (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Comma-separated admin emails (automatically granted admin role)
SEVENXAIR_ADMIN_EMAILS=you@example.com

# Random 32+ char secret for local fallback session signing
SEVENXAIR_SESSION_SECRET=replace-with-long-random-secret

# Optional GitHub repository (owner/repo) for release links
GITHUB_REPO=your-username/7xair
