{
  "schemaVersion": 1,
  "id": "sevenxair",
  "version": "${version}",
  "name": "7xAir Client",
  "description": "Genuinely translucent floating glass HUD, ClickGUI, HUD editor, and PvP utilities managed by the 7xAir Launcher.",
  "authors": ["7xAir Contributors"],
  "contact": {
    "homepage": "https://7xair.vercel.app"
  },
  "license": "MIT",
  "icon": "assets/sevenxair/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.sevenxair.client.SevenXAirClient"
    ]
  },
  "mixins": [
    "7xair.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
