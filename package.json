{
  "name": "7xair-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "7xAir Windows Minecraft launcher, custom Fabric client, and web platform",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/launcher run dev",
    "build": "npm --workspace apps/launcher run build",
    "typecheck": "npm --workspace apps/launcher run typecheck",
    "tauri:dev": "npm --workspace apps/launcher run tauri:dev",
    "tauri:build": "npm --workspace apps/launcher run tauri:build",
    "web:dev": "node scripts/website-server.mjs",
    "package:zip": "python3 scripts/package-source-zip.py",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev:preview": "node scripts/dev-server.mjs"
  }
}
